# Copy to .env and fill in. Every variable is prefixed VM_.

# --- required ---------------------------------------------------------------
# Long random string; protects /v1/admin/* and the dashboard.
VM_ADMIN_API_KEY=change-me-to-a-long-random-string

# --- storage ----------------------------------------------------------------
# Local dev default is SQLite. Production: postgresql+asyncpg://user:pass@host/db
VM_DATABASE_URL=sqlite+aiosqlite:///./version_manager.db
# Optional. Without it a per-process memory cache is used (fine for one replica).
# VM_REDIS_URL=redis://localhost:6379/0

# --- client access ----------------------------------------------------------
# Optional comma-separated keys the plugin must send as X-Api-Key.
# VM_CLIENT_API_KEYS=public-key-1,public-key-2
# Optional HMAC secret for signed responses (see README).
# VM_RESPONSE_SIGNING_SECRET=

# --- behaviour --------------------------------------------------------------
VM_SYNC_INTERVAL_SECONDS=900
VM_RESPONSE_CACHE_TTL_SECONDS=60
VM_RATE_LIMIT_PER_MINUTE=120
# Treat Play staged rollouts ("inProgress") as published. Default false.
VM_INCLUDE_IN_PROGRESS_ROLLOUTS=false
VM_SYNC_ON_STARTUP=true
# VM_CORS_ORIGINS=https://admin.example.com

# --- Google Play (Android) --------------------------------------------------
# Service account JSON with access to the app in Play Console. Either a path
# or the JSON contents inline.
# VM_GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/secrets/play-service-account.json
# VM_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- App Store Connect (iOS + TestFlight) -----------------------------------
# API key from App Store Connect → Users and Access → Integrations → App Store Connect API.
# VM_APP_STORE_CONNECT_ISSUER_ID=
# VM_APP_STORE_CONNECT_KEY_ID=
# VM_APP_STORE_CONNECT_PRIVATE_KEY_FILE=/secrets/AuthKey_XXXXXXXXXX.p8
# or the PEM contents inline:
# VM_APP_STORE_CONNECT_PRIVATE_KEY=
